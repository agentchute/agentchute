{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "name": "agentchute-poller",
            "type": "command",
            "command": "${AGENTCHUTE_BIN:-agentchute} poller ensure --quiet"
          },
          {
            "name": "agentchute-boot",
            "type": "command",
            "command": "${AGENTCHUTE_BIN:-agentchute} boot --context-only"
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "agentchute-turn-end",
            "type": "command",
            "command": "${AGENTCHUTE_BIN:-agentchute} turn-end --json"
          },
          {
            "name": "agentchute-poller",
            "type": "command",
            "command": "${AGENTCHUTE_BIN:-agentchute} poller ensure --quiet"
          },
          {
            "name": "agentchute-pending",
            "type": "command",
            "command": "${AGENTCHUTE_BIN:-agentchute} pending --json"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "agentchute-guard",
            "type": "command",
            "command": "${AGENTCHUTE_BIN:-agentchute} guard --pre-tool-use --gemini-hook BeforeTool"
          }
        ]
      }
    ]
  }
}
